# Salin file ini jadi .env lalu isi sesuai lingkungan kamu.
# Catatan: semua variabel VITE_* ikut terbundle ke browser (publik),
# jadi API key di sini BUKAN rahasia. Validasi tetap harus di backend.
VITE_API_BASE_URL=http://localhost/api_borneoacademy/store/
VITE_UPLOAD_BASE_URL=http://localhost/borneo_academy/upload/store/
VITE_API_KEY_HEADER=BA-KEY
VITE_API_KEY=isi_api_key_di_sini

# Khusus testing lokal: langsung arahkan ke /verifikasi setelah daftar
# (hanya aktif di `npm run dev`, diabaikan di build production).
VITE_AUTO_VERIFY=false
